<%- include('partials/head') %>
<body>
<div class="phone">
  <div class="auth-wrap">
    <div class="auth-card">
      <div class="auth-title">Buat Akun Baru</div>
      <div class="auth-sub">Lengkapi formulir pendaftaran akun</div>

      <div class="auth-error hidden" id="authError"></div>
      <div class="auth-success hidden" id="authSuccess"></div>

      <form id="registerForm" class="auth-form" novalidate>
        <div class="input-row">
          <i data-lucide="circle-user"></i>
          <input type="text" id="registerUsername" placeholder="Username (contoh: AlwaysRizz505)" required autocomplete="username" pattern="[a-zA-Z0-9_]{3,20}">
        </div>
        <div class="input-row">
          <i data-lucide="mail"></i>
          <input type="email" id="registerEmail" placeholder="Email" required autocomplete="email">
        </div>
        <div class="input-row">
          <i data-lucide="lock"></i>
          <input type="password" id="registerPassword" placeholder="Password" required autocomplete="new-password">
          <i data-lucide="eye-off" class="toggle-pass" data-target="registerPassword"></i>
        </div>
        <div class="input-row">
          <i data-lucide="lock-keyhole"></i>
          <input type="password" id="registerPasswordConfirm" placeholder="Konfirmasi Password" required autocomplete="new-password">
          <i data-lucide="eye-off" class="toggle-pass" data-target="registerPasswordConfirm"></i>
        </div>

        <button type="submit" class="auth-submit" id="registerSubmitBtn"><span>Daftar Akun</span></button>

        <div class="auth-footer-note">
          Sudah punya akun? <a href="/login">Masuk di sini</a>
        </div>
      </form>
    </div>
  </div>
</div>

<script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
<script src="/js/auth.js"></script>
<script>
  if (window.lucide) { lucide.createIcons(); }
</script>
</body>
</html>
