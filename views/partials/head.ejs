<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>VIP Tools</title>
<style>
:root{
  --bg: #060a14;
  --bg-soft: #0c1120;
  --card: #0f1830;
  --card-2: #131f3d;
  --line: rgba(79,140,255,0.14);
  --text: #eef1fa;
  --muted: #7e8bab;
  --accent: #3b82f6;
  --accent-2: #2f6bff;
  --green: #34d17a;
  --amber: #ffb648;
  --danger: #ff5d6c;
  --radius: 18px;
}
*{ box-sizing:border-box; -webkit-tap-highlight-color:transparent; }
html,body{ margin:0; padding:0; }
body{
  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Inter, sans-serif;
  min-height:100vh;
  display:flex;
  justify-content:center;
}
.phone{
  width:100%;
  max-width:460px;
  min-height:100vh;
  background: radial-gradient(1200px 500px at 50% -10%, rgba(79,140,255,0.10), transparent 60%), var(--bg);
  position:relative;
  padding-bottom:40px;
}

/* HEADER */
.header{
  display:flex;
  align-items:center;
  gap:12px;
  padding:22px 18px 16px;
}
.avatar{
  width:46px; height:46px; border-radius:50%;
  background: conic-gradient(from 200deg, var(--accent), var(--accent-2), #ff6ba0, var(--accent));
  display:flex; align-items:center; justify-content:center;
  font-size:20px;
  flex-shrink:0;
  overflow:hidden;
}
.avatar img{
  width:100%; height:100%;
  object-fit:cover;
  border-radius:50%;
}
.h-title{ font-size:19px; font-weight:700; letter-spacing:0.2px; }
.h-sub{ display:flex; align-items:center; gap:6px; font-size:12.5px; color: var(--green); font-weight:600; margin-top:2px; }
.dot{ width:7px; height:7px; border-radius:50%; background:var(--green); box-shadow:0 0 8px var(--green); }

/* HERO BANNER */
.banner{
  margin:4px 18px 16px;
  height:180px;
  border-radius: var(--radius);
  background: linear-gradient(160deg, #131a2e, #0c0f1a 70%);
  position:relative;
  overflow:hidden;
  display:flex;
  flex-direction:column;
  justify-content:flex-end;
  padding:16px 18px;
  border:1px solid var(--line);
}
.banner-video{
  position:absolute;
  inset:0;
  width:100%;
  height:100%;
  object-fit:cover;
  z-index:0;
}
.banner-overlay{
  position:absolute;
  inset:0;
  background:
    linear-gradient(180deg, rgba(10,13,22,0.15), rgba(10,13,22,0.85) 85%),
    radial-gradient(120% 140% at 15% 0%, rgba(124,92,255,0.35), transparent 55%);
  z-index:1;
}
.banner::before{
  content:"";
  position:absolute; inset:0;
  z-index:1;
  background-image:
    radial-gradient(2px 2px at 20% 30%, rgba(255,255,255,0.5), transparent),
    radial-gradient(2px 2px at 70% 60%, rgba(255,255,255,0.35), transparent),
    radial-gradient(1.5px 1.5px at 40% 80%, rgba(255,255,255,0.4), transparent),
    radial-gradient(1.5px 1.5px at 85% 20%, rgba(255,255,255,0.4), transparent);
  opacity:0.8;
}
.banner-eyebrow{ position:relative; z-index:2; font-size:11px; letter-spacing:2px; color:var(--accent); font-weight:700; text-transform:uppercase; }
.banner-title{ position:relative; z-index:2; font-size:22px; font-weight:800; margin-top:4px; }
.banner-desc{ position:relative; z-index:2; font-size:12.5px; color:var(--muted); margin-top:4px; }

/* INFO CARD */
.info-card{
  margin:0 18px 20px;
  background: var(--card);
  border:1px solid var(--line);
  border-radius: var(--radius);
  overflow:hidden;
}
.info-row{
  display:flex; align-items:center; justify-content:space-between;
  padding:14px 16px;
}
.info-row + .info-row{ border-top:1px solid var(--line); }
.info-left{ display:flex; align-items:center; gap:10px; color:var(--muted); font-size:14px; }
.info-icon{ width:18px; text-align:center; display:inline-flex; align-items:center; justify-content:center; }
.info-icon i, .info-icon svg{ width:18px; height:18px; color: var(--muted); stroke: currentColor; }
.info-val{ color:var(--accent); font-weight:700; font-size:14px; }

/* PROFILE CARD */
.profile-card{
  margin:0 18px 14px;
}
.profile-header{
  display:flex; align-items:center; gap:12px;
  margin-bottom:14px;
}
.profile-avatar{
  width:52px; height:52px; border-radius:50%;
  background: conic-gradient(from 200deg, var(--accent), var(--accent-2), #ff6ba0, var(--accent));
  border:2px solid var(--card);
  box-shadow: 0 0 0 2px var(--accent);
  display:flex; align-items:center; justify-content:center;
  color:#fff; font-weight:800; font-size:20px;
  flex-shrink:0;
}
.profile-name{ font-size:16px; font-weight:800; }
.profile-email{ font-size:12.5px; color:var(--muted); margin-top:2px; }

.profile-avatar-wrap{
  position:relative;
  flex-shrink:0;
  cursor:pointer;
}
.profile-avatar-img{
  width:52px; height:52px; border-radius:50%;
  object-fit:cover;
  border:2px solid var(--card);
  box-shadow: 0 0 0 2px var(--accent);
  display:block;
}
.avatar-edit-badge{
  position:absolute; bottom:-2px; right:-2px;
  width:20px; height:20px; border-radius:50%;
  background: var(--accent);
  border:2px solid var(--bg);
  display:flex; align-items:center; justify-content:center;
  color:#fff;
}
.avatar-edit-badge i, .avatar-edit-badge svg{ width:11px; height:11px; stroke:currentColor; }

/* WHATSAPP BANNER */
.wa-banner{
  display:flex; align-items:center; gap:12px;
  margin:0 18px 20px;
  padding:14px 16px;
  background: rgba(52,209,122,0.08);
  border:1px solid rgba(52,209,122,0.35);
  border-radius: var(--radius);
  text-decoration:none;
  color: var(--text);
}
.wa-banner-icon{
  width:36px; height:36px; border-radius:50%;
  background: rgba(52,209,122,0.18);
  display:flex; align-items:center; justify-content:center;
  flex-shrink:0;
  color:#34d17a;
}
.wa-banner-icon i, .wa-banner-icon svg{ width:19px; height:19px; stroke:currentColor; }
.wa-banner-text{ flex:1; min-width:0; }
.wa-banner-title{ font-size:13.5px; font-weight:800; }
.wa-banner-sub{ font-size:11.5px; color:var(--muted); margin-top:2px; line-height:1.4; }
.wa-banner > i, .wa-banner > svg{ width:18px; height:18px; color:var(--muted); flex-shrink:0; stroke:currentColor; }

/* TOOLS LABEL */
.section-label{
  display:flex; align-items:center; gap:10px;
  margin:6px 18px 12px;
  font-size:13px; font-weight:800; letter-spacing:1px; color:var(--text);
}
.section-label .bar{ width:16px; height:3px; border-radius:2px; background:var(--accent); }

/* TABS */
.tabs{
  display:flex; gap:8px;
  margin:0 18px 18px;
  overflow-x:auto;
  scrollbar-width:none;
}
.tabs::-webkit-scrollbar{ display:none; }
.tab{
  display:flex; align-items:center; gap:6px;
  white-space:nowrap;
  padding:9px 14px;
  border-radius:12px;
  background: var(--card);
  border:1px solid var(--line);
  color:var(--muted);
  font-size:12.5px; font-weight:700; letter-spacing:0.3px;
  cursor:pointer;
  transition: all .15s ease;
}
.tab.active{
  background: rgba(79,140,255,0.14);
  border-color: rgba(79,140,255,0.5);
  color: var(--accent);
}
.tab i, .tab svg{ width:14px; height:14px; stroke: currentColor; }

/* GRID */
.grid{
  display:grid;
  grid-template-columns: repeat(3, 1fr);
  gap:10px;
  padding:0 18px;
}
.card{
  background: var(--card);
  border:1px solid var(--line);
  border-radius:16px;
  padding:16px 10px 12px;
  display:flex; flex-direction:column; align-items:center; text-align:center;
  gap:6px;
  cursor:pointer;
  transition: transform .12s ease, border-color .12s ease;
  position:relative;
}
.card:active{ transform: scale(0.96); }
.card.game:hover, .card.game:active{ border-color: rgba(124,92,255,0.6); }
.card-icon{
  width:42px; height:42px;
  border-radius:12px;
  display:flex; align-items:center; justify-content:center;
  font-size:20px;
  background: rgba(59,130,246,0.12);
  margin-bottom:2px;
}
.card-icon i, .card-icon svg{ width:22px; height:22px; color: var(--accent); stroke: currentColor; }
.card-name{ font-size:13px; font-weight:700; }
.card-sub{ font-size:10.5px; color:var(--muted); }
.badge{
  margin-top:2px;
  font-size:9.5px; font-weight:800; letter-spacing:0.5px;
  padding:2px 8px; border-radius:999px;
  background: rgba(79,140,255,0.14); color:var(--accent);
}
.badge.new{ background: rgba(52,209,122,0.15); color:var(--green); }
.card-arrow{ position:absolute; bottom:8px; right:10px; color:var(--muted); font-size:13px; }
.card.disabled{ opacity:0.45; cursor:default; }
.card.disabled:active{ transform:none; }

.hidden{ display:none !important; }

/* GAME OVERLAY */
.overlay{
  position:fixed; inset:0;
  background: var(--bg);
  z-index:50;
  display:flex; flex-direction:column;
  max-width:460px; margin:0 auto;
}
.g-topbar{
  display:flex; align-items:center; gap:12px;
  padding:18px;
  border-bottom:1px solid var(--line);
}
.g-back{
  width:36px; height:36px; border-radius:10px;
  background:var(--card); border:1px solid var(--line);
  display:flex; align-items:center; justify-content:center;
  font-size:16px; color:var(--text); cursor:pointer;
}
.g-title{ font-size:16px; font-weight:800; flex:1; }
.g-score{ font-size:12.5px; color:var(--muted); font-weight:700; }
.g-score b{ color:var(--accent); }

.g-body{
  flex:1;
  display:flex; flex-direction:column; align-items:center; justify-content:center;
  padding:16px;
  gap:14px;
  position:relative;
}

/* SNAKE */
#snakeCanvas{
  background: var(--card);
  border:1px solid var(--line);
  border-radius:16px;
  touch-action:none;
  width:100%;
  max-width:360px;
  aspect-ratio:1/1;
}

/* 2048 */
.g2048-board{
  position:relative;
  width:100%;
  max-width:340px;
  aspect-ratio:1/1;
  background: var(--card);
  border:1px solid var(--line);
  border-radius:16px;
  padding:8px;
  touch-action:none;
}
.g2048-grid{
  display:grid;
  grid-template-columns: repeat(4,1fr);
  grid-template-rows: repeat(4,1fr);
  gap:8px;
  width:100%; height:100%;
}
.g2048-cell{
  background: rgba(255,255,255,0.04);
  border-radius:10px;
}
.g2048-tiles{ position:absolute; inset:8px; }
.tile{
  position:absolute;
  display:flex; align-items:center; justify-content:center;
  border-radius:10px;
  font-weight:800;
  transition: left .1s ease, top .1s ease, transform .1s ease;
  color:#fff;
}

/* GRAVITY FLIP */
#gravityCanvas{
  background: linear-gradient(180deg, #131829 0%, #0e1220 100%);
  border:1px solid var(--line);
  border-radius:16px;
  touch-action:none;
  width:100%;
  max-width:360px;
  aspect-ratio:1/1;
}

/* KETUK REFLEKS */
#reflexCanvas{
  background: var(--card);
  border:1px solid var(--line);
  border-radius:16px;
  touch-action:none;
  width:100%;
  max-width:360px;
  aspect-ratio:1/1;
}

/* STACK TOWER */
#stackCanvas{
  background: linear-gradient(180deg, #131829 0%, #0e1220 100%);
  border:1px solid var(--line);
  border-radius:16px;
  touch-action:none;
  width:100%;
  max-width:300px;
  aspect-ratio:4/5;
}

/* OTAK KILAT */
.otak-board{
  display:grid;
  grid-template-columns: repeat(2, 1fr);
  grid-template-rows: repeat(2, 1fr);
  gap:12px;
  width:100%;
  max-width:280px;
  aspect-ratio:1/1;
}
.otak-tile{
  border-radius:18px;
  opacity:0.35;
  transition: opacity .12s ease, transform .12s ease;
  cursor:pointer;
}
.otak-tile.lit{
  opacity:1;
  transform: scale(0.96);
}
.otak-tile.wrong{
  opacity:1;
  filter: brightness(0.5) saturate(2);
}

/* TEPUK TIKUS */
.mole-timer{ font-size:13px; font-weight:800; color:var(--accent); margin-bottom:4px; }
.mole-grid{
  display:grid;
  grid-template-columns: repeat(3, 1fr);
  gap:10px;
  width:100%;
  max-width:280px;
}
.mole-hole{
  aspect-ratio:1/1;
  border-radius:16px;
  background: radial-gradient(circle at 50% 60%, rgba(0,0,0,0.35), rgba(0,0,0,0.15));
  border:1px solid var(--line);
  display:flex; align-items:flex-end; justify-content:center;
  overflow:hidden;
  cursor:pointer;
}
.mole{
  font-size:30px;
  transform: translateY(100%);
  transition: transform .12s ease;
}
.mole-hole.up .mole{ transform: translateY(6%); }

/* COCOK KARTU */
.memory-grid{
  display:grid;
  grid-template-columns: repeat(4, 1fr);
  gap:8px;
  width:100%;
  max-width:280px;
}
.memory-card{
  aspect-ratio:3/4;
  border-radius:10px;
  background: var(--accent);
  display:flex; align-items:center; justify-content:center;
  font-size:22px;
  cursor:pointer;
  transform-style: preserve-3d;
  transition: transform .18s ease, background .18s ease;
}
.memory-card .memory-face{
  opacity:0;
  transition: opacity .1s ease;
}
.memory-card.flipped, .memory-card.matched{
  background: var(--card);
  border:1px solid var(--line);
}
.memory-card.flipped .memory-face, .memory-card.matched .memory-face{ opacity:1; }
.memory-card.matched{ opacity:0.45; }

/* HITUNG CEPAT */
.math-timer{ font-size:13px; font-weight:800; color:var(--accent); margin-bottom:10px; }
.math-quiz{ display:flex; flex-direction:column; align-items:center; gap:20px; width:100%; max-width:280px; }
.math-question{ font-size:32px; font-weight:800; letter-spacing:1px; }
.math-options{ display:grid; grid-template-columns: repeat(2, 1fr); gap:12px; width:100%; }
.math-opt{
  padding:16px 8px;
  border-radius:14px;
  background: var(--card);
  border:1px solid var(--line);
  font-size:18px; font-weight:800;
  text-align:center;
  cursor:pointer;
}
.math-opt:active{ transform: scale(0.95); }
.math-opt.correct{ background: rgba(52,209,122,0.25); border-color:#34d17a; }
.math-opt.wrong{ background: rgba(255,93,108,0.25); border-color:#ff5d6c; }

.g-hint{ font-size:12px; color:var(--muted); text-align:center; }
.g-actions{ display:flex; gap:10px; }

/* PUZZLE GESER */
.puzzle-grid{
  display:grid;
  grid-template-columns: repeat(3, 1fr);
  grid-template-rows: repeat(3, 1fr);
  gap:8px;
  width:100%;
  max-width:260px;
  aspect-ratio:1/1;
}
.puzzle-tile{
  border-radius:12px;
  background: var(--accent);
  color:#fff;
  display:flex; align-items:center; justify-content:center;
  font-size:24px; font-weight:800;
  cursor:pointer;
  transition: transform .1s ease;
}
.puzzle-tile:active{ transform: scale(0.94); }
.puzzle-tile.empty{
  background: transparent;
  cursor:default;
}
.puzzle-win{
  text-align:center; font-weight:800; color:#34d17a; font-size:15px;
}

/* SUSUN KATA */
.word-timer{ font-size:13px; font-weight:800; color:var(--accent); margin-bottom:6px; }
.word-answer{
  display:flex; gap:8px; justify-content:center; flex-wrap:wrap;
  min-height:46px;
  margin-bottom:22px;
}
.word-answer .letter-slot{
  width:38px; height:42px;
  border-radius:10px;
  border:2px solid var(--line);
  background: var(--card);
  display:flex; align-items:center; justify-content:center;
  font-size:19px; font-weight:800;
  color: var(--accent);
  cursor:pointer;
}
.word-letters{
  display:flex; gap:8px; justify-content:center; flex-wrap:wrap;
  max-width:300px;
}
.word-letters .letter-tile{
  width:38px; height:42px;
  border-radius:10px;
  background: var(--accent);
  color:#fff;
  display:flex; align-items:center; justify-content:center;
  font-size:19px; font-weight:800;
  cursor:pointer;
  transition: transform .1s ease, opacity .1s ease;
}
.word-letters .letter-tile:active{ transform: scale(0.9); }
.word-letters .letter-tile.used{
  opacity:0.25;
  pointer-events:none;
}
.word-clear{
  display:inline-block;
  margin-left:8px;
  color:#ff5d6c;
  font-weight:700;
  cursor:pointer;
}
.g-btn{
  padding:10px 18px; border-radius:12px;
  background: var(--card); border:1px solid var(--line);
  color:var(--text); font-weight:700; font-size:13px; cursor:pointer;
}
.g-btn.primary{ background: var(--accent); border-color:var(--accent); color:#fff; }

/* GAME START SCREEN */
.g-start-screen{
  flex:1;
  width:100%;
  display:flex; flex-direction:column; align-items:center; justify-content:center;
  gap:16px;
  text-align:center;
}
.g-start-icon{
  width:76px; height:76px; border-radius:22px;
  background: var(--card);
  border:1px solid var(--line);
  display:flex; align-items:center; justify-content:center;
  font-size:34px;
}
.g-start-title{ font-size:17px; font-weight:800; }
.g-start-desc{ font-size:12.5px; color:var(--muted); max-width:260px; line-height:1.5; }
.g-start-btn{
  display:flex; align-items:center; gap:8px;
  padding:13px 30px; border-radius:14px;
  background: var(--accent); border:1px solid var(--accent);
  color:#fff; font-weight:800; font-size:14px; cursor:pointer;
  margin-top:6px;
}
.g-start-btn:active{ transform: scale(0.96); }
.g-start-btn i, .g-start-btn svg{ width:18px; height:18px; }
.g-game-content{
  width:100%;
  flex:1;
  display:flex; flex-direction:column; align-items:center; justify-content:center;
  gap:14px;
}

.dl-tip{
  display:flex; align-items:flex-start; gap:8px;
  background: rgba(255,182,72,0.1);
  border:1px solid rgba(255,182,72,0.25);
  border-radius:12px;
  padding:12px 14px;
  font-size:12.5px;
  color: var(--muted);
  line-height:1.4;
}

.dl-input-wrap{
  display:flex; align-items:center; gap:10px;
  padding:0 14px;
  border-radius:12px;
  background: var(--card);
  border:1px solid var(--line);
}
.dl-input-icon{ display:flex; align-items:center; color: var(--accent); flex-shrink:0; }
.dl-input-icon i, .dl-input-icon svg{ width:18px; height:18px; stroke:currentColor; }
.dl-input{
  flex:1;
  min-width:0;
  padding:14px 0;
  border:none;
  background:transparent;
  color: var(--text);
  font-size:14px;
}
.dl-input:focus{ outline:none; }
.dl-input::placeholder{ color: var(--muted); }

.dl-search-btn{
  display:flex; align-items:center; justify-content:center; gap:8px;
  text-align:center;
}
.dl-search-btn i, .dl-search-btn svg{ width:16px; height:16px; stroke:currentColor; }

.dl-msg{ font-size:13px; color: var(--muted); text-align:center; padding:8px 0; }
.dl-msg.error{ color: var(--danger); }

.dl-card{
  background: var(--card);
  border:1px solid var(--line);
  border-radius:16px;
  padding:16px;
  display:flex; flex-direction:column; gap:14px;
}
.dl-card-head{ display:flex; flex-direction:column; gap:4px; }
.dl-author{ font-size:14px; font-weight:700; }
.dl-caption{
  font-size:12.5px;
  color: var(--muted);
  font-style: italic;
  line-height:1.4;
  display:-webkit-box;
  -webkit-line-clamp:2;
  -webkit-box-orient:vertical;
  overflow:hidden;
}
.dl-video{
  width:100%;
  border-radius:12px;
  background:#000;
  max-height:420px;
}
.dl-cover{
  width:100%;
  border-radius:12px;
  object-fit:cover;
}

/* UPLOADER GAMBAR */
.img-upload-drop{
  border:2px dashed var(--line);
  border-radius:14px;
  padding:28px 16px;
  display:flex; flex-direction:column; align-items:center; justify-content:center;
  gap:8px;
  cursor:pointer;
  color: var(--muted);
  font-size:13px;
  text-align:center;
}
.img-upload-drop i, .img-upload-drop svg{ width:26px; height:26px; stroke:currentColor; color:var(--accent); }
.img-upload-preview{ width:100%; margin-bottom:10px; }
.img-upload-preview img{
  width:100%; max-height:220px; object-fit:contain;
  border-radius:12px; background:#000;
}
