}
.theme-btn i, .theme-btn svg{ width:18px; height:18px; stroke:currentColor; }
.theme-btn:active{ transform: scale(0.94); }

/* THEME MODAL */
.theme-overlay{
  position:fixed; inset:0;
  background: rgba(6,10,20,0.75);
  backdrop-filter: blur(3px);
  z-index:80;
  display:flex; align-items:center; justify-content:center;
  padding:20px;
}
.theme-modal{
  position:relative;
  width:100%; max-width:340px;
  background: var(--card);
  border:1px solid var(--line);
  border-radius: var(--radius);
  padding:28px 22px 24px;
  box-shadow: 0 20px 60px rgba(0,0,0,0.5);
  animation: theme-pop .18s ease;
}
@keyframes theme-pop{
  from{ transform: scale(0.92); opacity:0; }
  to{ transform: scale(1); opacity:1; }
}
.theme-modal-close{
  position:absolute; top:-10px; right:-10px;
  width:32px; height:32px; border-radius:10px;
  background: var(--danger);
  display:flex; align-items:center; justify-content:center;
  color:#fff; cursor:pointer;
  box-shadow: 0 6px 16px rgba(255,93,108,0.4);
}
.theme-modal-close i, .theme-modal-close svg{ width:16px; height:16px; stroke:currentColor; }
.theme-modal-title{
  text-align:center;
  font-size:15px; font-weight:800; letter-spacing:1.5px;
  text-transform:uppercase;
  color: var(--accent);
  margin-bottom:20px;
}
.theme-grid{
  display:flex;
  flex-wrap:wrap;
  gap:14px;
  justify-content:center;
}
.theme-box{
  width:56px; height:56px;
  flex:0 0 56px;
  border-radius:14px;
  cursor:pointer;
  position:relative;
  border:2px solid rgba(255,255,255,0.08);
  transition: transform .12s ease, border-color .12s ease;
}
.theme-box:active{ transform: scale(0.92); }
.theme-box.active{
  border-color:#fff;
  box-shadow: 0 0 0 3px var(--accent);
}
.theme-box.active::after{
  content:"✓";
  position:absolute; inset:0;
  display:flex; align-items:center; justify-content:center;
  color:#fff; font-weight:800; font-size:20px;
  text-shadow: 0 1px 3px rgba(0,0,0,0.5);
}

