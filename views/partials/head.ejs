  font-weight:800;
  font-size:15px;
  cursor:pointer;
  margin-top:4px;
}
.auth-submit:active{ transform: scale(0.98); }
.auth-submit:disabled{ opacity:0.6; }
.auth-footer-note{
  text-align:center;
  font-size:13px;
  color: var(--muted);
  background: var(--bg-soft);
  border:1px solid var(--line);
  border-radius:14px;
