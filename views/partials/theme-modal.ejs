<div class="theme-overlay hidden" id="themeOverlay">
  <div class="theme-modal">
    <div class="theme-modal-close" id="themeClose"><i data-lucide="x"></i></div>
    <div class="theme-modal-title">Select Theme</div>
    <div class="theme-grid">
      <div class="theme-box" data-theme="cyan" style="background: linear-gradient(135deg,#22e5ff,#0891b2)"></div>
      <div class="theme-box" data-theme="purple" style="background: linear-gradient(135deg,#a78bfa,#7c5cff)"></div>
      <div class="theme-box" data-theme="red" style="background: linear-gradient(135deg,#ff8a93,#ff5d6c)"></div>

      <div class="theme-box" data-theme="green" style="background: linear-gradient(135deg,#5eeaa0,#22b866)"></div>
      <div class="theme-box" data-theme="yellow" style="background: linear-gradient(135deg,#ffd166,#f5a623)"></div>
      <div class="theme-box" data-theme="silver" style="background: linear-gradient(135deg,#e2e8f0,#94a3b8)"></div>

      <div class="theme-box" data-theme="gray" style="background: linear-gradient(135deg,#7c8ba1,#475569)"></div>
      <div class="theme-box" data-theme="orange" style="background: linear-gradient(135deg,#ffb648,#f97316)"></div>
      <div class="theme-box active" data-theme="blue" style="background: linear-gradient(135deg,#4f8cff,#2f6bff)"></div>
    </div>
  </div>
</div>
